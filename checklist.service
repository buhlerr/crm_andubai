[Unit]
Description=Checklist Pos-Venda (Egali CRM)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/crm_andubai
Environment="CHECKLIST_DADOS=/opt/crm_andubai/dados"
Environment="SERVIDOR_HOST=0.0.0.0"
Environment="SERVIDOR_PORTA=8080"
Environment="ATRAS_DE_PROXY=1"
# SECRET_KEY: opcional. Sem ela, o sistema gera uma na primeira subida e guarda em <CHECKLIST_DADOS>/secret_key.
# Senha da equipe (só para a transição, LOGIN_PROVISORIO=1): ponha no config.py da pasta de dados, não aqui.
Environment="LOGIN_PROVISORIO=0"
ExecStart=/opt/crm_andubai/venv/bin/gunicorn -w 4 -b 0.0.0.0:8080 --timeout 300 wsgi:app
Restart=always
RestartSec=5

# Limites e segurança
LimitNOFILE=65535
PrivateTmp=true

[Install]
WantedBy=multi-user.target
