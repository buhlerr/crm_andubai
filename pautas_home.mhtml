m-origin: 1px 1px 0px; animation: 1250ms linear -625ms infinite normal none=
 running timer-loader; }

.la-timer > div::before { height: 8px; }

.la-timer > div::after { height: 6px; animation-duration: 15s; animation-de=
lay: -7.5s; }

